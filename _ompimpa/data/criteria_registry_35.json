{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "OMP-IMPA 35-Row Quality Criteria Registry (port dari agyimpa)",
  "version": "1.0.0-ompimpa",
  "description": "Single source of truth 35 kriteria evaluasi TEA untuk 9-Review Squad dan Triage Remediation Engine Elixir/Phoenix/Ash Suite.",
  "dimensions": [
    "Functional & Correctness",
    "Security & Compliance",
    "Architecture & Clean Spine",
    "Reliability & Performance",
    "Idioms, Testing & Maintainability"
  ],
  "scoring_weights": {
    "Critical": 30,
    "High": 15,
    "Medium": 5,
    "Low": 2
  },
  "criteria": [
    {
      "id": "TEA-01",
      "index": 1,
      "category": "Functional & Correctness",
      "name": "Story Acceptance Criteria Traceability",
      "description": "Memastikan 100% Acceptance Criteria (AC) pada spesifikasi story terpenuhi tanpa deviasi, celah implementasi, atau scope drift.",
      "default_severity": "High",
      "default_priority": "P1",
      "penalty": 15,
      "reviewer_sources": [
        "phx_requirements",
        "bmad_gap_verifier"
      ],
      "rule_patterns": [
        "AC-*",
        "REQ-*",
        "FUNC-AC-*"
      ],
      "ompimpa_panel": [
        "ompimpa-prd",
        "ompimpa-prd:gap-verifier"
      ],
      "enforcement": "Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-02",
      "index": 2,
      "category": "Functional & Correctness",
      "name": "Boundary & Extreme Data Resilience",
      "description": "Ketahanan terhadap nilai batas ekstrem, input kosong, nil, boundary integer/float, format string tak lazim, dan boundary payload.",
      "default_severity": "Critical",
      "default_priority": "P0",
      "penalty": 30,
      "reviewer_sources": [
        "bmad_adversarial"
      ],
      "rule_patterns": [
        "ADV-EDGE-*",
        "EDGE-CASE-*",
        "CRASH-*"
      ],
      "ompimpa_panel": [
        "ompimpa-prd:adversarial"
      ],
      "enforcement": "Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-03",
      "index": 3,
      "category": "Functional & Correctness",
      "name": "State & Data Mutation Consistency",
      "description": "Konsistensi mutasi data multi-tahap, integritas transaksi database Ecto, dan isolasi state socket LiveView / Ash domain.",
      "default_severity": "High",
      "default_priority": "P1",
      "penalty": 15,
      "reviewer_sources": [
        "phx_ash_policy",
        "phx_requirements"
      ],
      "rule_patterns": [
        "STATE-*",
        "MUTATION-*",
        "DATA-INTEGRITY-*"
      ],
      "ompimpa_panel": [
        "ompimpa-ash",
        "ompimpa-prd"
      ],
      "enforcement": "Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-04",
      "index": 4,
      "category": "Functional & Correctness",
      "name": "Explicit Error Handling & Graceful Degradation",
      "description": "Penanganan kegagalan secara eksplisit dengan pattern matching {:ok, _} / {:error, _} atau konstruksi with/else, tanpa silent rescue.",
      "default_severity": "High",
      "default_priority": "P1",
      "penalty": 15,
      "reviewer_sources": [
        "phx_elixir_idioms",
        "bmad_adversarial"
      ],
      "rule_patterns": [
        "ERR-HANDLE-*",
        "SILENT-FAIL-*",
        "UNHANDLED-ERROR-*"
      ],
      "ompimpa_panel": [
        "ompimpa-prd:adversarial",
        "ompimpa-verify"
      ],
      "enforcement": "Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-05",
      "index": 5,
      "category": "Functional & Correctness",
      "name": "Deterministic Business Logic",
      "description": "Logika bisnis murni deterministik bebas dari efek samping tersembunyi, ketergantungan urutan proses yang ambigu, atau race condition.",
      "default_severity": "Medium",
      "default_priority": "P2",
      "penalty": 5,
      "reviewer_sources": [
        "phx_requirements",
        "phx_elixir_idioms"
      ],
      "rule_patterns": [
        "LOGIC-*",
        "DETERMINISTIC-*"
      ],
      "ompimpa_panel": [
        "ompimpa-prd",
        "ompimpa-verify"
      ],
      "enforcement": "Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-06",
      "index": 6,
      "category": "Functional & Correctness",
      "name": "Ash Action & DSL Semantic Alignment",
      "description": "Kesesuaian semantik aksi resource Ash (create, read, update, destroy), validasi changesets, dan integritas domain relationship.",
      "default_severity": "High",
      "default_priority": "P1",
      "penalty": 15,
      "reviewer_sources": [
        "phx_ash_policy"
      ],
      "rule_patterns": [
        "ASH-ACTION-*",
        "ASH-DSL-*",
        "ASH-CHANGE-*"
      ],
      "ompimpa_panel": [
        "ompimpa-ash"
      ],
      "enforcement": "Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-07",
      "index": 7,
      "category": "Functional & Correctness",
      "name": "Regression Guard & Invariant Preservation",
      "description": "Pencegahan terhadap regresi fungsional yang merusak fungsionalitas modul terkait atau melanggar invariant arsitektur.",
      "default_severity": "High",
      "default_priority": "P1",
      "penalty": 15,
      "reviewer_sources": [
        "bmad_gap_verifier",
        "bmad_adversarial"
      ],
      "rule_patterns": [
        "REGRESSION-*",
        "INVARIANT-*"
      ],
      "ompimpa_panel": [
        "ompimpa-prd:adversarial",
        "ompimpa-prd:gap-verifier"
      ],
      "enforcement": "Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-08",
      "index": 8,
      "category": "Security & Compliance",
      "name": "Sobelow SAST Vulnerability Prevention",
      "description": "Pencegahan celah keamanan SAST Sobelow meliputi SQL injection, XSS HEEX, path traversal, RCE, dan insecure deserialization (Iron Law 19).",
      "default_severity": "Critical",
      "default_priority": "P0",
      "penalty": 30,
      "reviewer_sources": [
        "phx_security_sobelow"
      ],
      "rule_patterns": [
        "SEC-SOBELOW*",
        "SOBELOW-*",
        "SEC-INJECTION-*",
        "IL-19*",
        "SEC-RAW-XSS*"
      ],
      "ompimpa_panel": [
        "ompimpa-security"
      ],
      "enforcement": "TTSR Tier0 + Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-09",
      "index": 9,
      "category": "Security & Compliance",
      "name": "Atom Table Exhaustion Guard (Iron Law 17)",
      "description": "Larangan konversi input pengguna tidak terpercaya menjadi atom via String.to_atom/1; wajib gunakan String.to_existing_atom/1 atau pattern matching.",
      "default_severity": "Critical",
      "default_priority": "P0",
      "penalty": 30,
      "reviewer_sources": [
        "phx_security_sobelow",
        "phx_iron_laws"
      ],
      "rule_patterns": [
        "IL-17*",
        "SEC-ATOM-*",
        "ATOM-EXHAUSTION*"
      ],
      "ompimpa_panel": [
        "ompimpa-ironlaw",
        "ompimpa-security"
      ],
      "enforcement": "TTSR Tier0 + Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-10",
      "index": 10,
      "category": "Security & Compliance",
      "name": "LiveView Event Authorization (Iron Law 18)",
      "description": "Validasi otorisasi dan identitas actor/session pada setiap callback handle_event/3 LiveView guna mencegah unauthorized action invocation.",
      "default_severity": "Critical",
      "default_priority": "P0",
      "penalty": 30,
      "reviewer_sources": [
        "phx_security_sobelow",
        "phx_iron_laws"
      ],
      "rule_patterns": [
        "IL-18*",
        "SEC-AUTH-EVENT*",
        "AUTH-HANDLE-EVENT*"
      ],
      "ompimpa_panel": [
        "ompimpa-ironlaw",
        "ompimpa-security"
      ],
      "enforcement": "TTSR Tier0 + Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-11",
      "index": 11,
      "category": "Security & Compliance",
      "name": "Multi-Tenant Actor & Tenant Isolation",
      "description": "Penegakan isolasi tenant dan actor pada resource Ash via Ash.Policy dan filter context, mencegah kebocoran data lintas organisasi.",
      "default_severity": "Critical",
      "default_priority": "P0",
      "penalty": 30,
      "reviewer_sources": [
        "phx_ash_policy",
        "phx_security_sobelow"
      ],
      "rule_patterns": [
        "ASH-POLICY-*",
        "TENANT-ISOLATION*",
        "SEC-TENANT-*"
      ],
      "ompimpa_panel": [
        "ompimpa-ash",
        "ompimpa-security"
      ],
      "enforcement": "TTSR Tier0 + Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-12",
      "index": 12,
      "category": "Security & Compliance",
      "name": "Raw SQL & Query Sanitization (Iron Law 04)",
      "description": "Larangan mutlak interpolasi string mentah pada fragment/query Ecto; wajib gunakan parameter pinning ^ atau parameterized fragment bindings.",
      "default_severity": "Critical",
      "default_priority": "P0",
      "penalty": 30,
      "reviewer_sources": [
        "phx_iron_laws",
        "phx_security_sobelow"
      ],
      "rule_patterns": [
        "IL-04*",
