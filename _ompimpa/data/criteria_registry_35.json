      "ompimpa_panel": [
        "ompimpa-security"
      ],
      "enforcement": "TTSR Tier0 + Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-14",
      "index": 14,
      "category": "Security & Compliance",
      "name": "CSRF & LiveView Channel Token Verification",
      "description": "Verifikasi token CSRF pada form submissions, upload endpoint, dan koneksi websocket / channel LiveView.",
      "default_severity": "High",
      "default_priority": "P1",
      "penalty": 15,
      "reviewer_sources": [
        "phx_security_sobelow"
      ],
      "rule_patterns": [
