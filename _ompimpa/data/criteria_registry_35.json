      ],
      "enforcement": "Review Tier1 (Rasuna Said / Structural)",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-17",
      "index": 17,
      "category": "Architecture & Clean Spine",
      "name": "Monetary Decimal Precision (Iron Law 01)",
