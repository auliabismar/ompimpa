        "ompimpa-security"
      ],
      "enforcement": "TTSR Tier0 + Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-13",
      "index": 13,
      "category": "Security & Compliance",
      "name": "Secrets & Credential Protection",
      "description": "Larangan penulisan rahasia (API key, password, token, webhook secret) secara langsung di kode sumber; wajib gunakan runtime env vars.",
      "default_severity": "Critical",
      "default_priority": "P0",
      "penalty": 30,
      "reviewer_sources": [
        "phx_security_sobelow"
      ],
      "rule_patterns": [
        "SEC-SECRET*",
        "HARDCODED-TOKEN*",
