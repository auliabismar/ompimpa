      "ompimpa_panel": [
        "ompimpa-security"
      ],
      "enforcement": "TTSR Tier0 + Review Tier1",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-15",
      "index": 15,
      "category": "Architecture & Clean Spine",
      "name": "Context Boundary & Public API Encapsulation",
      "description": "Larangan pemanggilan Repo atau query schema secara langsung lintas konteks domain; seluruh akses wajib melalui Context Public API atau Ash Action.",
      "default_severity": "High",
      "default_priority": "P1",
      "penalty": 15,
      "reviewer_sources": [
