      ],
      "enforcement": "Review Tier1 (Rasuna Said / Structural)",
      "scoring_version": "v2"
    },
    {
      "id": "TEA-16",
      "index": 16,
      "category": "Architecture & Clean Spine",
      "name": "Circular Dependency Prevention (mix xref)",
      "description": "Mencegah pembentukan dependensi sirkular antar modul context atau komponen web yang memicu kompilasi berulang dan tight coupling.",
      "default_severity": "High",
      "default_priority": "P1",
      "penalty": 15,
      "reviewer_sources": [
